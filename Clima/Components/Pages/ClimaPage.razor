@page "/registos"
@using Clima.Components.Pages.Dialogs
@using Clima.Data
@using Clima.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@inject AppDbContext DbContext
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Monitorização de Dados Climáticos</PageTitle>

<style>
    .dashboard-container {
        border-radius: 1rem;
        padding: 1.5rem;
    }

    .header-card {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        border-radius: 0.75rem;
        transition: all 0.3s ease;
    }

    .dashboard-card {
        border-radius: 0.75rem;
        transition: all 0.3s ease;
        height: 100%;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    }

    .dashboard-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
    }


    /* Responsive adjustments */
    @@media (max-width: 600px) {
        .dashboard-container {
            padding: 0.5rem;
        }

        .header-card {
            text-align: center;
        }

            .header-card .mud-icon {
                display: none;
            }
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="dashboard-container mt-4">
    <!-- Header -->
    <MudItem xs="12">
        <MudPaper Elevation="8" Class="header-card pa-4 mb-4 d-flex align-center flex-wrap">
            <div class="d-flex align-center flex-grow-1">
                <MudIcon Icon="@Icons.Material.Filled.ThermostatAuto" Color="Color.Inherit" Size="Size.Large" Class="mr-3 d-none d-md-flex" />
                <div>
                    <MudText Typo="Typo.h4" Style="color:white;">Painel de Monitorização Climática</MudText>
                    <MudText Typo="Typo.body2" Style="color:white;" Class="opacity-75">
                        Dados em tempo real • Última atualização:
                        @(latestRecord?.data_registo.ToString("dd/MM/yyyy HH:mm") ?? "Carregando...")
                    </MudText>
                </div>
            </div>
        </MudPaper>
    </MudItem>

    <!-- Recent Readings and Statistics -->
    <MudGrid Class="mb-6">
        <!-- Recent Readings - Responsive Layout -->
        <MudItem xs="12" lg="6">
            <MudPaper Elevation="5" Class="dashboard-card card-gradient-1 pa-4 mb-6">
                <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-3 fw-bold">Leituras Recentes</MudText>
                <MudDivider Class="mb-4" />

                @if (latestRecord != null)
                {
                    <MudGrid>
                        <MudItem xs="12" sm="4">
                            <MudPaper Elevation="1" Class="pa-4 rounded-lg border-1 mb-3" Style="border-style: solid; border-color: rgba(0,0,0,0.12);">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Style="height:100%;flex-wrap:wrap;">
                                    <MudIcon Icon="@Icons.Material.Filled.Thermostat" Color="@GetTemperatureColor(latestRecord.risco_temperatura)" Size="Size.Large" Class="mr-3" />
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.subtitle1">Temperatura</MudText>
                                        <MudText Typo="Typo.h4" Color="@GetTemperatureColor(latestRecord.risco_temperatura)">
                                            @latestRecord.temperatura.ToString("F1") °C
                                        </MudText>
                                        <MudChip Color="@GetTemperatureColor(latestRecord.risco_temperatura)" Size="Size.Small" Class="mt-1" T="string">
                                            Nível de Risco: @latestRecord.risco_temperatura
                                        </MudChip>
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudPaper Elevation="1" Class="pa-4 rounded-lg border-1 mb-3" Style="border-style: solid; border-color: rgba(0,0,0,0.12);">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Style="flex-wrap:wrap;">
                                    <MudIcon Icon="@Icons.Material.Filled.WaterDrop" Color="@GetHumidityColor(latestRecord.risco_humidade)" Size="Size.Large" Class="mr-3" />
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.subtitle1">Humidade</MudText>
                                        <MudText Typo="Typo.h4" Color="@GetHumidityColor(latestRecord.risco_humidade)">
                                            @latestRecord.humidade.ToString("F1") %
                                        </MudText>
                                        <MudChip Color="@GetHumidityColor(latestRecord.risco_humidade)" Size="Size.Small" Class="mt-1" T="string">
                                            Nível de Risco: @latestRecord.risco_humidade
                                        </MudChip>
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudPaper Elevation="1" Class="pa-4 rounded-lg border-1 mb-3" Style="border-style: solid; border-color: rgba(0,0,0,0.12);">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Style="flex-wrap:wrap;">
                                    <MudIcon Icon="@Icons.Material.Filled.Grass" Color="@GetSoilHumidityColor(latestRecord.risco_humidade_solo)" Size="Size.Large" Class="mr-3" />
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.subtitle1">Humidade Solo</MudText>
                                        <MudText Typo="Typo.h4" Color="@GetSoilHumidityColor(latestRecord.risco_humidade_solo)">
                                            @latestRecord.humidade_solo.ToString("F1") %
                                        </MudText>
                                        <MudChip Color="@GetSoilHumidityColor(latestRecord.risco_humidade_solo)" Size="Size.Small" Class="mt-1" T="string">
                                            Nível de Risco: @latestRecord.risco_humidade_solo
                                        </MudChip>
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                    <MudText Typo="Typo.body2" Class="mt-3 d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Class="mr-2" />
                        Última Atualização: @latestRecord.data_registo.ToString("g")
                    </MudText>
                }
                else
                {
                    <MudSkeleton Width="100%" Height="160px" Animation="Animation.Pulse" />
                }
            </MudPaper>
        </MudItem>

        <!-- Statistics - Responsive Layout -->
        <MudItem xs="12" lg="6">
            <MudPaper Elevation="5" Class="dashboard-card card-gradient-2 pa-4 mb-6">
                <MudText Typo="Typo.h5" Color="Color.Secondary" Class="mb-3 fw-bold">Estatísticas</MudText>
                <MudDivider Class="mb-4" />

                @if (statistics != null)
                {
                    <MudPaper Elevation="1" Class="pa-4 rounded-lg border-1 mb-x\3" Style="border-style: solid; border-color: rgba(0,0,0,0.12);">
                        <MudGrid>
                            <MudItem xs="6">
                                <MudStack>
                                    <MudText Typo="Typo.caption" Color="Color.Primary">
                                        <MudIcon Icon="@Icons.Material.Filled.Numbers" Size="Size.Small" Class="mr-1" />Total de Registos
                                    </MudText>
                                    <MudText Typo="Typo.h6">@statistics.TotalRecords</MudText>
                                </MudStack>
                            </MudItem>
                            <MudItem xs="6">
                                <MudStack>
                                    <MudText Typo="Typo.caption" Color="Color.Primary">
                                        <MudIcon Icon="@Icons.Material.Filled.DateRange" Size="Size.Small" Class="mr-1" />Intervalo de Datas
                                    </MudText>
                                    <MudText Typo="Typo.h6">@statistics.DateRange</MudText>
                                </MudStack>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    <MudGrid>
                        <MudItem xs="12" sm="4">
                            <MudPaper Elevation="1" Class="pa-4 rounded-lg border-1" Style="border-style: solid; border-color: rgba(0,0,0,0.12);">
                                <MudText Typo="Typo.subtitle2" Color="Color.Primary">Estatísticas de Temperatura</MudText>
                                <MudDivider Class="my-2" />
                                <MudStack>
                                    <MudText Typo="Typo.body2">
                                        <MudIcon Icon="@Icons.Material.Filled.Calculate" Size="Size.Small" Class="mr-1" />
                                        Média: <b>@statistics.AvgTemperature.ToString("F1") °C</b>
                                    </MudText>
                                    <MudText Typo="Typo.body2">
                                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Class="mr-1" Color="Color.Error" />
                                        Máxima: <b>@statistics.MaxTemperature.ToString("F1") °C</b>
                                    </MudText>
                                    <MudText Typo="Typo.body2">
                                        <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Size="Size.Small" Class="mr-1" Color="Color.Info" />
                                        Mínima: <b>@statistics.MinTemperature.ToString("F1") °C</b>
                                    </MudText>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudPaper Elevation="1" Class="pa-4 rounded-lg border-1" Style="border-style: solid; border-color: rgba(0,0,0,0.12);">
                                <MudText Typo="Typo.subtitle2" Color="Color.Primary">Estatísticas de Humidade</MudText>
                                <MudDivider Class="my-2" />
                                <MudStack>
                                    <MudText Typo="Typo.body2">
                                        <MudIcon Icon="@Icons.Material.Filled.Calculate" Size="Size.Small" Class="mr-1" />
                                        Média: <b>@statistics.AvgHumidity.ToString("F1") %</b>
                                    </MudText>
                                    <MudText Typo="Typo.body2">
                                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Class="mr-1" Color="Color.Error" />
                                        Máxima: <b>@statistics.MaxHumidity.ToString("F1") %</b>
                                    </MudText>
                                    <MudText Typo="Typo.body2">
                                        <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Size="Size.Small" Class="mr-1" Color="Color.Info" />
                                        Mínima: <b>@statistics.MinHumidity.ToString("F1") %</b>
                                    </MudText>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudPaper Elevation="1" Class="pa-4 rounded-lg border-1" Style="border-style: solid; border-color: rgba(0,0,0,0.12);">
                                <MudText Typo="Typo.subtitle2" Color="Color.Primary">Estatísticas de Humidade do Solo</MudText>
                                <MudDivider Class="my-2" />
                                <MudStack>
                                    <MudText Typo="Typo.body2">
                                        <MudIcon Icon="@Icons.Material.Filled.Calculate" Size="Size.Small" Class="mr-1" />
                                        Média: <b>@statistics.AvgSoilHumidity.ToString("F1") %</b>
                                    </MudText>
                                    <MudText Typo="Typo.body2">
                                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Class="mr-1" Color="Color.Error" />
                                        Máxima: <b>@statistics.MaxSoilHumidity.ToString("F1") %</b>
                                    </MudText>
                                    <MudText Typo="Typo.body2">
                                        <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Size="Size.Small" Class="mr-1" Color="Color.Info" />
                                        Mínima: <b>@statistics.MinSoilHumidity.ToString("F1") %</b>
                                    </MudText>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                }
                else
                {
                    <MudSkeleton Width="100%" Height="160px" Animation="Animation.Pulse" />
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- Climate Records Section -->
    <MudPaper Elevation="0" Class="dashboard-card card-gradient-1 pa-4 mb-6">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <MudText Typo="Typo.h5" Color="Color.Primary" Class="fw-bold">Registos Climáticos</MudText>
            <MudStack Row="true">
                <MudTooltip Text="Exportar Dados">
                    <MudIconButton Icon="@Icons.Material.Filled.FileDownload" Color="Color.Default" OnClick="DownloadExcel" />
                </MudTooltip>
                <MudTooltip Text="Atualizar Dados">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Default" OnClick="LoadData" />
                </MudTooltip>
            </MudStack>
        </MudStack>

        <!-- Filters Section -->
        <MudExpansionPanels DisableBorders="true" Elevation="0" Class="mb-4">
            <MudExpansionPanel Text="Filtros" Icon="@Icons.Material.Filled.FilterList" IsInitiallyExpanded="true">
                <MudGrid>
                    <MudItem xs="12" sm="6" md="3">
                        <MudDateRangePicker Label="Data"
                                            @bind-DateRange="dateRange"
                                            AdornmentIcon="@Icons.Material.Filled.DateRange" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudSelect T="int" Label="Risco de Temperatura"
                                   @bind-Value="tempRiskFilter" AdornmentIcon="@Icons.Material.Filled.Thermostat">
                            <MudSelectItem Value="-1">Todos os Níveis</MudSelectItem>
                            <MudSelectItem Value="0">Sem Risco (0)</MudSelectItem>
                            <MudSelectItem Value="1">Risco Baixo (1)</MudSelectItem>
                            <MudSelectItem Value="2">Risco Médio (2)</MudSelectItem>
                            <MudSelectItem Value="3">Risco Alto (3)</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudSelect T="int" Label="Risco de Humidade"
                                   @bind-Value="humidRiskFilter" AdornmentIcon="@Icons.Material.Filled.WaterDrop">
                            <MudSelectItem Value="-1">Todos os Níveis</MudSelectItem>
                            <MudSelectItem Value="0">Sem Risco (0)</MudSelectItem>
                            <MudSelectItem Value="1">Risco Baixo (1)</MudSelectItem>
                            <MudSelectItem Value="2">Risco Médio (2)</MudSelectItem>
                            <MudSelectItem Value="3">Risco Alto (3)</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudSelect T="int" Label="Risco de Humidade Solo"
                                   @bind-Value="soilHumidRiskFilter" AdornmentIcon="@Icons.Material.Filled.Grass">
                            <MudSelectItem Value="-1">Todos os Níveis</MudSelectItem>
                            <MudSelectItem Value="0">Sem Risco (0)</MudSelectItem>
                            <MudSelectItem Value="1">Risco Baixo (1)</MudSelectItem>
                            <MudSelectItem Value="2">Risco Médio (2)</MudSelectItem>
                            <MudSelectItem Value="3">Risco Alto (3)</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="2" Class="d-flex align-center justify-end">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Search" FullWidth="true"
                                   OnClick="ApplyFilters">
                            Aplicar Filtros
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudExpansionPanel>
        </MudExpansionPanels>

        <div class="data-table">
            <MudTable Items="@registos" Dense="true" Hover="true" Bordered="false" Striped="true" Elevation="0"
                      Loading="@loading" LoadingProgressColor="Color.Primary" Height="450px"
                      Breakpoint="Breakpoint.Sm" Class="rounded-lg">
                <ToolBarContent>
                    <MudText Typo="Typo.subtitle1" Class="mud-text-secondary py-2">
                        <MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="Size.Small" Class="mr-1" />
                        Total de Registos: @registos.Count
                    </MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="searchString" Placeholder="Pesquisar registos..." Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>ID</MudTh>
                    <MudTh>Data e Hora</MudTh>
                    <MudTh>Temperatura (°C)</MudTh>
                    <MudTh>Risco Temp.</MudTh>
                    <MudTh>Humidade (%)</MudTh>
                    <MudTh>Risco Humid.</MudTh>
                    <MudTh>Humid. Solo (%)</MudTh>
                    <MudTh>Risco Solo</MudTh>
                    <MudTh>Ações</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="ID">@context.ID_registo</MudTd>
                    <MudTd DataLabel="Data e Hora">
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" Class="mr-2" />
                            @context.data_registo.ToString("g")
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="Temperatura">
                        <MudText Color="@GetTemperatureColor(context.risco_temperatura)">
                            @context.temperatura.ToString("F1")
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Risco Temp.">
                        <MudChip Size="Size.Small" Color="@GetTemperatureColor(context.risco_temperatura)" T="string"
                                 Class="ma-0 px-2 py-1">
                            @context.risco_temperatura
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Humidade">
                        <MudText Color="@GetHumidityColor(context.risco_humidade)">
                            @context.humidade.ToString("F1")
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Risco Humid.">
                        <MudChip Size="Size.Small" Color="@GetHumidityColor(context.risco_humidade)" T="string"
                                 Class="ma-0 px-2 py-1">
                            @context.risco_humidade
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Humid. Solo">
                        <MudText Color="@GetSoilHumidityColor(context.risco_humidade_solo)">
                            @context.humidade_solo.ToString("F1")
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Risco Solo">
                        <MudChip Size="Size.Small" Color="@GetSoilHumidityColor(context.risco_humidade_solo)" T="string"
                                 Class="ma-0 px-2 py-1">
                            @context.risco_humidade_solo
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Ações">
                        <MudTooltip Text="Ver Detalhes">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => ViewDetails(context))" />
                        </MudTooltip>
                        <MudTooltip Text="Eliminar Registo">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => DeleteRecord(context))" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4 d-flex justify-center align-center">
                        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Class="mr-2" /> Nenhum registo encontrado com os critérios selecionados.
                    </MudText>
                </NoRecordsContent>
                <LoadingContent>
                    <MudText Class="pa-4 d-flex justify-center align-center">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" Class="mr-2" />
                        A carregar dados climáticos...
                    </MudText>
                </LoadingContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" RowsPerPageString="P/pág" />
                </PagerContent>
            </MudTable>
        </div>
    </MudPaper>
</MudContainer>


<script>
    window.downloadFileFromStream = (fileName, contentType, base64Data) => {
        // Create a link element
        const link = document.createElement('a');

        // Create blob from base64 data
        const byteCharacters = atob(base64Data);
        const byteNumbers = new Array(byteCharacters.length);

        for (let i = 0; i < byteCharacters.length; i++) {
            byteNumbers[i] = byteCharacters.charCodeAt(i);
        }

        const byteArray = new Uint8Array(byteNumbers);
        const blob = new Blob([byteArray], { type: contentType });

        // Create download URL
        const url = URL.createObjectURL(blob);

        // Set link properties
        link.href = url;
        link.download = fileName;

        // Append to the body temporarily
        document.body.appendChild(link);

        // Trigger download
        link.click();

        // Cleanup
        document.body.removeChild(link);
        URL.revokeObjectURL(url);
    }
</script>